        "raw": "48656c6c6f",
        "encoding": "binary"
      },
      "charset": {
        "preset": "ddu"
      },
      "options": {
        "checksum": true,
        "checksumScope": "plaintext"
      },
      "checksumSource": "plaintext",
      "expected": {
        "encoded": "읶뜟잉듖욷뜟뎾뭐CKPf7d18982",
        "checksumMarker": "CK",
        "scopeChar": "P",
        "checksumHex": "f7d18982"
      },
