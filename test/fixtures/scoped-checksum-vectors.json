{
  "version": "scoped-checksum-v1",
  "description": "ddunigma scoped checksum wire-format deterministic test vectors. Footer checksum suffix: CK[P|O][8 lowercase hex]. payload+footer identical to 4.x. Encrypted vectors are round-trip-only (random IV).",
  "markerSpec": {
    "checksumMarkerScoped": "CK",
    "scopeChars": {
      "plaintext": "P",
      "output": "O"
    },
    "suffixPattern": "^CK[PO][0-9a-f]{8}$",
    "legacyMarker": "CHK",
    "notes": "Decoder must try scoped checksum (CK[PO][8hex]) first, then legacy CHK[8hex]. Fixed-length + scope char + 8 hex validation mitigates accidental collisions in charsets containing C/H/K and hex digits."
  },
  "vectors": [
    {
      "id": "scoped-ascii-hello-plain-scopeP",
      "description": "ASCII 'Hello', no-compress, checksumScope=plaintext",
